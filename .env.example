# FlowSentinel AI — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Billing provider: mock | stripe | mercadopago | pagarme
# -----------------------------------------------------------------------------
BILLING_PROVIDER=mock

# Stripe (when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Mercado Pago (when BILLING_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Pagar.me — adapter stub only (not implemented in this MVP)
# PAGARME_API_KEY=
# PAGARME_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Database / Supabase
# -----------------------------------------------------------------------------
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI providers (Vercel AI SDK adapters)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# Observability & analytics
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Email (Resend or SMTP adapter)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=FlowSentinel <noreply@flowsentinel.ai>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
